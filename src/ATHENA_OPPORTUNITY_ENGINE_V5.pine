//@version=6

indicator(
     "ATHENA V5 - Risk Management Engine",
     overlay=true,
     max_labels_count=500,
     max_lines_count=500
)


// =====================================
// ATHENA V5
// SPRINT 12
// RISK MANAGEMENT ENGINE
// =====================================


showSignals = input.bool(true,"Afficher Signaux")


// =====================================
// TREND ENGINE
// =====================================


ema50 = ta.ema(close,50)
ema200 = ta.ema(close,200)


bullTrend = ema50 > ema200
bearTrend = ema50 < ema200


trendScore =
     bullTrend ? 30 :
     bearTrend ? -30 :
     0




// =====================================
// MOMENTUM ENGINE
// =====================================


rsiValue = ta.rsi(close,14)


bullMomentum = rsiValue > 55
bearMomentum = rsiValue < 45



momentumScore =
     bullMomentum ? 25 :
     bearMomentum ? -25 :
     0




// =====================================
// VOLATILITY ENGINE
// =====================================


atrValue = ta.atr(14)

atrAverage = ta.sma(atrValue,20)


volatilityScore =
     atrValue > atrAverage ? 15 : 0




// =====================================
// STRUCTURE ENGINE
// =====================================


pivotLength = input.int(
     5,
     "Structure Length"
)


pivotHigh = ta.pivothigh(
     high,
     pivotLength,
     pivotLength
)


pivotLow = ta.pivotlow(
     low,
     pivotLength,
     pivotLength
)



var float lastHigh = na
var float lastLow = na



if not na(pivotHigh)
    lastHigh := pivotHigh



if not na(pivotLow)
    lastLow := pivotLow




bullBOS =
     not na(lastHigh)
     and close > lastHigh



bearBOS =
     not na(lastLow)
     and close < lastLow




structureScore =
     bullBOS ? 20 :
     bearBOS ? -20 :
     0




// =====================================
// LIQUIDITY ENGINE
// =====================================


liqHigh = ta.highest(high,20)

liqLow = ta.lowest(low,20)



buyLiquiditySweep =
     low < liqLow[1]
     and close > liqLow[1]



sellLiquiditySweep =
     high > liqHigh[1]
     and close < liqHigh[1]



liquidityScore =
     buyLiquiditySweep ? 10 :
     sellLiquiditySweep ? -10 :
     0



// =====================================
// TOTAL SCORE
// =====================================


totalScore =

     trendScore +
     momentumScore +
     volatilityScore +
     structureScore +
     liquidityScore
     // =====================================
// ATHENA MULTI CONFIRMATION ENGINE
// =====================================


bullConfirmations = 0
bearConfirmations = 0



bullConfirmations += trendScore > 0 ? 1 : 0
bullConfirmations += momentumScore > 0 ? 1 : 0
bullConfirmations += structureScore > 0 ? 1 : 0
bullConfirmations += liquidityScore > 0 ? 1 : 0



bearConfirmations += trendScore < 0 ? 1 : 0
bearConfirmations += momentumScore < 0 ? 1 : 0
bearConfirmations += structureScore < 0 ? 1 : 0
bearConfirmations += liquidityScore < 0 ? 1 : 0




// =====================================
// ATHENA DECISION ENGINE
// =====================================


buySignal =

     bullConfirmations >= 2
     and totalScore >= 50



sellSignal =

     bearConfirmations >= 2
     and totalScore <= -50





// =====================================
// SIGNAL QUALITY
// =====================================


signalQuality =

     totalScore >= 80 ? "ELITE" :
     totalScore >= 60 ? "HIGH" :
     totalScore >= 40 ? "MEDIUM" :
     "LOW"




marketDirection =

     totalScore > 0 ? "BULLISH" :
     totalScore < 0 ? "BEARISH" :
     "NEUTRAL"






// =====================================
// RISK MANAGEMENT ENGINE
// SPRINT 12
// =====================================


riskMultiplier = input.float(
     1.5,
     "ATR Stop Multiplier"
)


rewardRatio1 = input.float(
     2.0,
     "TP1 Ratio"
)


rewardRatio2 = input.float(
     3.0,
     "TP2 Ratio"
)



atrRisk = ta.atr(14)



entryPrice = close




// BUY PLAN

buySL = entryPrice - (atrRisk * riskMultiplier)


buyTP1 =
     entryPrice + ((entryPrice - buySL) * rewardRatio1)


buyTP2 =
     entryPrice + ((entryPrice - buySL) * rewardRatio2)




// SELL PLAN


sellSL = entryPrice + (atrRisk * riskMultiplier)


sellTP1 =
     entryPrice - ((sellSL - entryPrice) * rewardRatio1)


sellTP2 =
     entryPrice - ((sellSL - entryPrice) * rewardRatio2)






// =====================================
// EMA DISPLAY
// =====================================


plot(
     ema50,
     title="EMA 50",
     color=color.green
)


plot(
     ema200,
     title="EMA 200",
     color=color.red
)
// =====================================
// ATHENA SIGNAL DISPLAY
// =====================================


plotshape(

     showSignals and buySignal,

     title="ATHENA BUY",

     style=shape.labelup,

     location=location.belowbar,

     color=color.green,

     text="ATHENA BUY",

     textcolor=color.white

)




plotshape(

     showSignals and sellSignal,

     title="ATHENA SELL",

     style=shape.labeldown,

     location=location.abovebar,

     color=color.red,

     text="ATHENA SELL",

     textcolor=color.white

)





// =====================================
// BOS DISPLAY
// =====================================


plotshape(

     bullBOS,

     title="Bullish BOS",

     style=shape.triangleup,

     location=location.belowbar,

     color=color.blue,

     text="BOS"

)



plotshape(

     bearBOS,

     title="Bearish BOS",

     style=shape.triangledown,

     location=location.abovebar,

     color=color.orange,

     text="BOS"

)






// =====================================
// TRADE PLAN VISUALIZATION
// =====================================



if buySignal

    line.new(
         bar_index,
         entryPrice,
         bar_index + 15,
         entryPrice,
         color=color.blue,
         width=2
    )


    line.new(
         bar_index,
         buySL,
         bar_index + 15,
         buySL,
         color=color.red,
         width=2
    )


    line.new(
         bar_index,
         buyTP1,
         bar_index + 15,
         buyTP1,
         color=color.green,
         width=2
    )


    line.new(
         bar_index,
         buyTP2,
         bar_index + 15,
         buyTP2,
         color=color.lime,
         width=2
    )





if sellSignal

    line.new(
         bar_index,
         entryPrice,
         bar_index + 15,
         entryPrice,
         color=color.blue,
         width=2
    )


    line.new(
         bar_index,
         sellSL,
         bar_index + 15,
         sellSL,
         color=color.red,
         width=2
    )


    line.new(
         bar_index,
         sellTP1,
         bar_index + 15,
         sellTP1,
         color=color.green,
         width=2
    )


    line.new(
         bar_index,
         sellTP2,
         bar_index + 15,
         sellTP2,
         color=color.lime,
         width=2
    )







// =====================================
// ATHENA DASHBOARD
// =====================================


var table athenaDashboard = table.new(

     position.top_right,

     2,

     9,

     border_width=1

)



if barstate.islast


    table.cell(
         athenaDashboard,
         0,
         0,
         "ATHENA V5"
    )


    table.cell(
         athenaDashboard,
         1,
         0,
         "SPRINT 12"
    )


    table.cell(
         athenaDashboard,
         0,
         1,
         "Score"
    )


    table.cell(
         athenaDashboard,
         1,
         1,
         str.tostring(totalScore)
    )


    table.cell(
         athenaDashboard,
         0,
         2,
         "Direction"
    )


    table.cell(
         athenaDashboard,
         1,
         2,
         marketDirection
    )


    table.cell(
         athenaDashboard,
         0,
         3,
         "Quality"
    )


    table.cell(
         athenaDashboard,
         1,
         3,
         signalQuality
    )


    table.cell(
         athenaDashboard,
         0,
         4,
         "Bull Confirm"
    )


    table.cell(
         athenaDashboard,
         1,
         4,
         str.tostring(bullConfirmations)
    )


    table.cell(
         athenaDashboard,
         0,
         5,
         "Bear Confirm"
    )


    table.cell(
         athenaDashboard,
         1,
         5,
         str.tostring(bearConfirmations)
    )


    table.cell(
         athenaDashboard,
         0,
         6,
         "Entry"
    )


    table.cell(
         athenaDashboard,
         1,
         6,
         str.tostring(entryPrice)
    )


    table.cell(
         athenaDashboard,
         0,
         7,
         "TP/SL"
    )


    table.cell(
         athenaDashboard,
         1,
         7,
         "ACTIVE"
    )


    table.cell(
         athenaDashboard,
         0,
         8,
         "Risk"
    )


    table.cell(
         athenaDashboard,
         1,
         8,
         "1:" + str.tostring(rewardRatio2)
    )