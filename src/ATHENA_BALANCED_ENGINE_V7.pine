//@version=6

indicator("ATHENA V7 - Balanced Institutional Engine", overlay=true, max_labels_count=500)


// =================================================
// PARAMETRES
// =================================================

showDashboard = input.bool(true, "Afficher Dashboard")
showSignals = input.bool(true, "Afficher Signaux")


// =================================================
// TREND ENGINE
// =================================================

emaFast = ta.ema(close,50)
emaSlow = ta.ema(close,200)

trendBullish = emaFast > emaSlow
trendBearish = emaFast < emaSlow

trendScore = trendBullish ? 30 : trendBearish ? -30 : 0



// =================================================
// MOMENTUM ENGINE
// =================================================

rsiValue = ta.rsi(close,14)

momentumBullish = rsiValue > 50
momentumBearish = rsiValue < 50

momentumScore = momentumBullish ? 20 : momentumBearish ? -20 : 0



// =================================================
// VOLATILITY ENGINE
// =================================================

atrValue = ta.atr(14)
atrAverage = ta.sma(atrValue,20)

volatilityConfirm = atrValue > atrAverage

volatilityScore = volatilityConfirm ? 10 : 0



// =================================================
// STRUCTURE ENGINE
// =================================================

pivotLength = input.int(5,"Structure Length")

pivotHigh = ta.pivothigh(high,pivotLength,pivotLength)
pivotLow = ta.pivotlow(low,pivotLength,pivotLength)


var float lastHigh = na
var float previousHigh = na

var float lastLow = na
var float previousLow = na


if not na(pivotHigh)
    previousHigh := lastHigh
    lastHigh := pivotHigh


if not na(pivotLow)
    previousLow := lastLow
    lastLow := pivotLow



higherHigh = not na(previousHigh) and lastHigh > previousHigh
higherLow  = not na(previousLow) and lastLow > previousLow

lowerHigh = not na(previousHigh) and lastHigh < previousHigh
lowerLow  = not na(previousLow) and lastLow < previousLow



bullStructure = higherHigh and higherLow
bearStructure = lowerHigh and lowerLow



structureScore = bullStructure ? 20 : bearStructure ? -20 : 0



// =================================================
// LIQUIDITY ENGINE
// =================================================

previousHighLiquidity = ta.highest(high,20)
previousLowLiquidity = ta.lowest(low,20)


liquidityBull = close > previousHighLiquidity
liquidityBear = close < previousLowLiquidity


liquidityScore = liquidityBull ? 10 : liquidityBear ? -10 : 0




// =================================================
// SCORE ATHENA
// =================================================

athenaScore = trendScore + momentumScore + volatilityScore + structureScore + liquidityScore



// =================================================
// CONFIRMATIONS
// =================================================

bullConfirm = 0
bullConfirm += trendBullish ? 1 : 0
bullConfirm += momentumBullish ? 1 : 0
bullConfirm += bullStructure ? 1 : 0
bullConfirm += liquidityBull ? 1 : 0


bearConfirm = 0
bearConfirm += trendBearish ? 1 : 0
bearConfirm += momentumBearish ? 1 : 0
bearConfirm += bearStructure ? 1 : 0
bearConfirm += liquidityBear ? 1 : 0



// =================================================
// QUALITE SIGNAL
// =================================================

signalQuality = 
     athenaScore >= 70 ? "ELITE" :
     athenaScore >= 55 ? "A" :
     athenaScore >= 40 ? "WATCH" :
     "WAIT"



// =================================================
// DECISION ENGINE V7
// =================================================


buySignal = 
     athenaScore >= 60 and 
     bullConfirm >= 2


sellSignal = 
     athenaScore <= -60 and 
     bearConfirm >= 2




// =================================================
// AFFICHAGE
// =================================================

plot(emaFast,color=color.green,title="EMA 50")
plot(emaSlow,color=color.red,title="EMA 200")



plotshape(
 buySignal and showSignals,
 title="ATHENA BUY",
 style=shape.labelup,
 location=location.belowbar,
 color=color.green,
 text="ATHENA BUY",
 textcolor=color.white
)



plotshape(
 sellSignal and showSignals,
 title="ATHENA SELL",
 style=shape.labeldown,
 location=location.abovebar,
 color=color.red,
 text="ATHENA SELL",
 textcolor=color.white
)



// =================================================
// DASHBOARD
// =================================================

var table dashboard = table.new(position.top_right,2,5)


if barstate.islast and showDashboard

    table.cell(dashboard,0,0,"ATHENA V7")
    table.cell(dashboard,1,0,"BALANCED")

    table.cell(dashboard,0,1,"Score")
    table.cell(dashboard,1,1,str.tostring(athenaScore))

    table.cell(dashboard,0,2,"Bull Conf")
    table.cell(dashboard,1,2,str.tostring(bullConfirm))

    table.cell(dashboard,0,3,"Bear Conf")
    table.cell(dashboard,1,3,str.tostring(bearConfirm))

    table.cell(dashboard,0,4,"Quality")
    table.cell(dashboard,1,4,signalQuality)