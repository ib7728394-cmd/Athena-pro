//@version=6

indicator(
     "ATHENA V6 - Institutional Signal Filter Engine",
     overlay=true,
     max_labels_count=500
)


// =====================================
// PARAMETRES
// =====================================

showSignals = input.bool(true,"Afficher Signaux")

cooldownBars = input.int(
     15,
     "Cooldown Signaux"
)


// =====================================
// TREND ENGINE
// =====================================

ema50 = ta.ema(close,50)
ema200 = ta.ema(close,200)


bullTrend = ema50 > ema200
bearTrend = ema50 < ema200


trendScore =
     bullTrend ? 25 :
     bearTrend ? -25 :
     0



// =====================================
// MOMENTUM ENGINE
// =====================================

rsi = ta.rsi(close,14)


bullMomentum = rsi > 55
bearMomentum = rsi < 45


momentumScore =
     bullMomentum ? 20 :
     bearMomentum ? -20 :
     0



// =====================================
// VOLATILITY ENGINE
// =====================================

atr = ta.atr(14)

atrMA = ta.sma(atr,20)


volatilityOK = atr > atrMA


volatilityScore =
     volatilityOK ? 15 : 0




// =====================================
// VOLUME ENGINE
// =====================================

volumeMA = ta.sma(volume,20)

volumeOK = volume > volumeMA


volumeScore =
     volumeOK ? 15 : 0




// =====================================
// STRUCTURE ENGINE
// =====================================


pivot = input.int(5)


highPivot = ta.pivothigh(
     high,
     pivot,
     pivot
)

lowPivot = ta.pivotlow(
     low,
     pivot,
     pivot
)


var float lastHigh = na
var float lastLow = na


if not na(highPivot)
    lastHigh := highPivot


if not na(lowPivot)
    lastLow := lowPivot



bullStructure =
     not na(lastHigh)
     and close > lastHigh



bearStructure =
     not na(lastLow)
     and close < lastLow



structureScore =
     bullStructure ? 20 :
     bearStructure ? -20 :
     0




// =====================================
// LIQUIDITY ENGINE
// =====================================


highest20 = ta.highest(high,20)

lowest20 = ta.lowest(low,20)



bullLiquidity =
     low < lowest20[1]
     and close > lowest20[1]


bearLiquidity =
     high > highest20[1]
     and close < highest20[1]



liquidityScore =
     bullLiquidity ? 15 :
     bearLiquidity ? -15 :
     0





// =====================================
// SCORE FINAL
// =====================================


athenaScore =

     trendScore +
     momentumScore +
     volatilityScore +
     volumeScore +
     structureScore +
     liquidityScore




// =====================================
// TOP CONFIRMATIONS
// =====================================


confirmations = 0


confirmations += bullTrend or bearTrend ? 1 : 0

confirmations += bullMomentum or bearMomentum ? 1 : 0

confirmations += bullStructure or bearStructure ? 1 : 0

confirmations += bullLiquidity or bearLiquidity ? 1 : 0

confirmations += volumeOK ? 1 : 0





// =====================================
// COOLDOWN
// =====================================


var int lastSignal = na


canSignal =

     na(lastSignal)
     or bar_index - lastSignal > cooldownBars





// =====================================
// SIGNALS
// =====================================


buySignal =

     canSignal
     and bullTrend
     and athenaScore >= 80
     and confirmations >= 3



sellSignal =

     canSignal
     and bearTrend
     and athenaScore <= -80
     and confirmations >= 3




if buySignal or sellSignal
    lastSignal := bar_index





// =====================================
// QUALITY
// =====================================


quality =

     athenaScore >= 95 ? "ELITE" :
     athenaScore >= 85 ? "A+" :
     athenaScore >= 80 ? "A" :
     "WAIT"




// =====================================
// AFFICHAGE
// =====================================


plot(
     ema50,
     color=color.green
)


plot(
     ema200,
     color=color.red
)



plotshape(
     showSignals and buySignal,
     style=shape.labelup,
     location=location.belowbar,
     color=color.green,
     text="ATHENA ELITE BUY"
)



plotshape(
     showSignals and sellSignal,
     style=shape.labeldown,
     location=location.abovebar,
     color=color.red,
     text="ATHENA ELITE SELL"
)




// =====================================
// DASHBOARD
// =====================================


var table dash = table.new(
     position.top_right,
     2,
     6
)


if barstate.islast

    table.cell(
         dash,
         0,
         0,
         "ATHENA V6"
    )

    table.cell(
         dash,
         1,
         0,
         "INSTITUTIONAL"
    )


    table.cell(
         dash,
         0,
         1,
         "Score"
    )


    table.cell(
         dash,
         1,
         1,
         str.tostring(athenaScore)
    )


    table.cell(
         dash,
         0,
         2,
         "Quality"
    )


    table.cell(
         dash,
         1,
         2,
         quality
    )


    table.cell(
         dash,
         0,
         3,
         "Confirmations"
    )


    table.cell(
         dash,
         1,
         3,
         str.tostring(confirmations)
    )


    table.cell(
         dash,
         0,
         4,
         "Trend"
    )


    table.cell(
         dash,
         1,
         4,
         bullTrend ? "BULL" : "BEAR"
    )


    table.cell(
         dash,
         0,
         5,
         "Status"
    )


    table.cell(
         dash,
         1,
         5,
         "ACTIVE"
    )