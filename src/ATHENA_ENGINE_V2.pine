//@version=6

indicator("ATHENA V2 - Institutional Intelligence Engine", overlay=true, max_labels_count=500)


// =====================================
// PARAMETRES
// =====================================

showSignals = input.bool(true,"Afficher Signaux")


// =====================================
// 1 - TREND ENGINE
// =====================================

ema50 = ta.ema(close,50)
ema200 = ta.ema(close,200)

bullTrend = ema50 > ema200
bearTrend = ema50 < ema200

trendScore = bullTrend ? 30 : bearTrend ? -30 : 0



// =====================================
// 2 - MOMENTUM ENGINE
// =====================================

rsi = ta.rsi(close,14)

bullMomentum = rsi > 55
bearMomentum = rsi < 45


momentumScore = bullMomentum ? 25 : bearMomentum ? -25 : 0



// =====================================
// 3 - VOLATILITY ENGINE
// =====================================

atr = ta.atr(14)

atrAverage = ta.sma(atr,20)

volatilityActive = atr > atrAverage

volatilityScore = volatilityActive ? 15 : 0



// =====================================
// 4 - STRUCTURE ENGINE
// =====================================

pivot = input.int(5,"Structure Length")

highPivot = ta.pivothigh(high,pivot,pivot)
lowPivot = ta.pivotlow(low,pivot,pivot)


var float lastHigh = na
var float lastLow = na


if not na(highPivot)
    lastHigh := highPivot

if not na(lowPivot)
    lastLow := lowPivot



bullBOS = not na(lastHigh) and close > lastHigh
bearBOS = not na(lastLow) and close < lastLow



structureScore = bullBOS ? 20 : bearBOS ? -20 : 0



// =====================================
// 5 - LIQUIDITY ENGINE
// =====================================


previousHigh = ta.highest(high,20)
previousLow = ta.lowest(low,20)


liquidityBuy = low < previousLow and close > previousLow

liquiditySell = high > previousHigh and close < previousHigh


liquidityScore = liquidityBuy ? 10 : liquiditySell ? -10 : 0



// =====================================
// ATHENA DECISION ENGINE
// =====================================


totalScore = 
     trendScore +
     momentumScore +
     volatilityScore +
     structureScore +
     liquidityScore



// COMPTE LES CONFIRMATIONS

bullConfirmations = 0
bearConfirmations = 0


bullConfirmations += trendScore > 0 ? 1 : 0
bullConfirmations += momentumScore > 0 ? 1 : 0
bullConfirmations += structureScore > 0 ? 1 : 0
bullConfirmations += liquidityScore > 0 ? 1 : 0


bearConfirmations += trendScore < 0 ? 1 : 0
bearConfirmations += momentumScore < 0 ? 1 : 0
bearConfirmations += structureScore < 0 ? 1 : 0
bearConfirmations += liquidityScore < 0 ? 1 : 0



// =====================================
// SYSTEME TOP 2 CONFIRMATIONS
// =====================================


buySignal =
     bullConfirmations >= 2
     and totalScore >= 50



sellSignal =
     bearConfirmations >= 2
     and totalScore <= -50



// =====================================
// AFFICHAGE
// =====================================


plot(ema50,color=color.green)

plot(ema200,color=color.red)



plotshape(
 buySignal,
 title="ATHENA TOP 2 BUY",
 style=shape.labelup,
 location=location.belowbar,
 color=color.green,
 text="ATHENA BUY\nTOP 2",
 textcolor=color.white
)



plotshape(
 sellSignal,
 title="ATHENA TOP 2 SELL",
 style=shape.labeldown,
 location=location.abovebar,
 color=color.red,
 text="ATHENA SELL\nTOP 2",
 textcolor=color.white
)



plotshape(
 bullBOS,
 title="Bull BOS",
 style=shape.triangleup,
 location=location.belowbar,
 color=color.blue,
 text="BOS"
)


plotshape(
 bearBOS,
 title="Bear BOS",
 style=shape.triangledown,
 location=location.abovebar,
 color=color.orange,
 text="BOS"
)