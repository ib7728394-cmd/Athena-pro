//@version=6

indicator(
     "ATHENA V5 - Signal Explanation Engine",
     overlay=true,
     max_labels_count=500
)


// =====================================
// ATHENA SIGNAL EXPLANATION ENGINE
// SPRINT 11
// =====================================


showSignals = input.bool(true,"Afficher Signaux")


// =====================================
// TREND ENGINE
// =====================================


ema50 = ta.ema(close,50)
ema200 = ta.ema(close,200)


bullTrend = ema50 > ema200
bearTrend = ema50 < ema200


trendScore = bullTrend ? 30 : bearTrend ? -30 : 0




// =====================================
// MOMENTUM ENGINE
// =====================================


rsiValue = ta.rsi(close,14)


bullMomentum = rsiValue > 55
bearMomentum = rsiValue < 45


momentumScore =
     bullMomentum ? 25 :
     bearMomentum ? -25 :
     0





// =====================================
// VOLATILITY ENGINE
// =====================================


atrValue = ta.atr(14)

atrAverage = ta.sma(atrValue,20)


volatilityActive = atrValue > atrAverage


volatilityScore =
     volatilityActive ? 15 : 0





// =====================================
// STRUCTURE ENGINE
// =====================================


pivotLength = input.int(
     5,
     "Structure Length"
)


pivotHigh = ta.pivothigh(
     high,
     pivotLength,
     pivotLength
)


pivotLow = ta.pivotlow(
     low,
     pivotLength,
     pivotLength
)



var float lastHigh = na
var float lastLow = na



if not na(pivotHigh)
    lastHigh := pivotHigh


if not na(pivotLow)
    lastLow := pivotLow




bullBOS =
     not na(lastHigh)
     and close > lastHigh



bearBOS =
     not na(lastLow)
     and close < lastLow




structureScore =
     bullBOS ? 20 :
     bearBOS ? -20 :
     0





// =====================================
// LIQUIDITY ENGINE
// =====================================


liquidityHigh = ta.highest(high,20)

liquidityLow = ta.lowest(low,20)



buyLiquiditySweep =
     low < liquidityLow[1]
     and close > liquidityLow[1]



sellLiquiditySweep =
     high > liquidityHigh[1]
     and close < liquidityHigh[1]



liquidityScore =
     buyLiquiditySweep ? 10 :
     sellLiquiditySweep ? -10 :
     0





// =====================================
// ATHENA TOTAL SCORE
// =====================================


totalScore =

     trendScore +
     momentumScore +
     volatilityScore +
     structureScore +
     liquidityScore
     // =====================================
// SYSTEME TOP 2 CONFIRMATIONS
// =====================================


bullConfirmations = 0
bearConfirmations = 0



bullConfirmations += trendScore > 0 ? 1 : 0
bullConfirmations += momentumScore > 0 ? 1 : 0
bullConfirmations += structureScore > 0 ? 1 : 0
bullConfirmations += liquidityScore > 0 ? 1 : 0



bearConfirmations += trendScore < 0 ? 1 : 0
bearConfirmations += momentumScore < 0 ? 1 : 0
bearConfirmations += structureScore < 0 ? 1 : 0
bearConfirmations += liquidityScore < 0 ? 1 : 0




// =====================================
// ATHENA DECISION
// =====================================


buySignal =

     bullConfirmations >= 2
     and totalScore >= 50



sellSignal =

     bearConfirmations >= 2
     and totalScore <= -50





// =====================================
// QUALITE SIGNAL
// =====================================


signalQuality =

     totalScore >= 80 ? "ELITE" :
     totalScore >= 60 ? "HIGH" :
     totalScore >= 40 ? "MEDIUM" :
     "LOW"




marketDirection =

     totalScore > 0 ? "BULLISH" :
     totalScore < 0 ? "BEARISH" :
     "NEUTRAL"





// =====================================
// AFFICHAGE EMA
// =====================================


plot(
     ema50,
     title="EMA 50",
     color=color.green
)



plot(
     ema200,
     title="EMA 200",
     color=color.red
)





// =====================================
// SIGNALS ATHENA
// =====================================


plotshape(

     showSignals and buySignal,

     title="ATHENA PREMIUM BUY",

     style=shape.labelup,

     location=location.belowbar,

     color=color.green,

     text="ATHENA BUY",

     textcolor=color.white

)





plotshape(

     showSignals and sellSignal,

     title="ATHENA PREMIUM SELL",

     style=shape.labeldown,

     location=location.abovebar,

     color=color.red,

     text="ATHENA SELL",

     textcolor=color.white

)





// =====================================
// BOS VISUALISATION
// =====================================


plotshape(

     bullBOS,

     title="Bullish BOS",

     style=shape.triangleup,

     location=location.belowbar,

     color=color.blue,

     text="BOS"

)



plotshape(

     bearBOS,

     title="Bearish BOS",

     style=shape.triangledown,

     location=location.abovebar,

     color=color.orange,

     text="BOS"

)





// =====================================
// ATHENA DASHBOARD
// =====================================


var table athenaTable = table.new(

     position.top_right,

     2,

     7,

     border_width=1

)



if barstate.islast


    table.cell(
         athenaTable,
         0,
         0,
         "ATHENA ENGINE"
    )


    table.cell(
         athenaTable,
         1,
         0,
         "ACTIVE"
    )


    table.cell(
         athenaTable,
         0,
         1,
         "Score"
    )


    table.cell(
         athenaTable,
         1,
         1,
         str.tostring(totalScore)
    )


    table.cell(
         athenaTable,
         0,
         2,
         "Direction"
    )


    table.cell(
         athenaTable,
         1,
         2,
         marketDirection
    )


    table.cell(
         athenaTable,
         0,
         3,
         "Bull Confirm"
    )


    table.cell(
         athenaTable,
         1,
         3,
         str.tostring(bullConfirmations)
    )


    table.cell(
         athenaTable,
         0,
         4,
         "Bear Confirm"
    )


    table.cell(
         athenaTable,
         1,
         4,
         str.tostring(bearConfirmations)
    )


    table.cell(
         athenaTable,
         0,
         5,
         "Quality"
    )


    table.cell(
         athenaTable,
         1,
         5,
         signalQuality
    )


    table.cell(
         athenaTable,
         0,
         6,
         "Version"
    )


    table.cell(
         athenaTable,
         1,
         6,
         "V5 SPRINT 11"
    )